{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Test Maven api-gateway",
      "type": "shell",
      "command": "mvn test -pl api-gateway",
      "group": "test"
    },
    {
      "label": "Maven verify",
      "type": "shell",
      "command": "mvn",
      "args": [
        "-B",
        "-Dmaven.project.sourceRoots.warningsDisabled=true",
        "clean",
        "verify"
      ]
    }
  ]
}
